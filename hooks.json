{
  "context-permission-reviewer": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "^(run_command|read_file|write_file|edit_file|view_file|write_to_file|replace_file_content|delete_file|call_mcp_tool|list_resources|read_resource|mcp_.*|browser_.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"./scripts/run_hook.cmd\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
